# Copy to frontend/.env.local and adjust. Never commit the real file.
# Read by the Next.js server only: none of these values reach the browser.

# FastAPI backend, as seen from the Next.js server.
API_URL=http://127.0.0.1:8000
# A key of the backend. Leave empty if the backend has none (local).
# On a public demo: the backend's DEMO_API_KEY (never the admin key), and
# IMPORTS_ENABLED=false (the demo key cannot import).
API_KEY=
IMPORTS_ENABLED=true
