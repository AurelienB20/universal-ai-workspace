# Copy to backend/.env and adjust. Never commit the real .env file.
# Every variable is optional; defaults are shown.

# local | test | production
APP_ENV=local
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# text | json (one JSON object per line, for a log collector)
LOG_FORMAT=text

# --- API protection ---
# Clients send it in the X-API-Key header. Required when APP_ENV=production;
# empty = the API is open (local development only).
API_KEY=
# Requests per client IP address (0 = no limit).
RATE_LIMIT_IMPORTS_PER_HOUR=10
RATE_LIMIT_SEARCH_PER_MINUTE=60
RATE_LIMIT_ASK_PER_MINUTE=10
MAX_REQUEST_BODY_KB=64

# --- Cost control ---
# Tokens per UTC day, all clients combined (0 = no budget). When spent, requests
# that need the provider get a 429 until midnight UTC.
DAILY_EMBEDDING_TOKEN_BUDGET=0
DAILY_LLM_TOKEN_BUDGET=0

# --- GitHub connector ---
# Optional. Raises the GitHub API rate limit from 60 to 5,000 requests/hour.
# A fine-grained token with no permissions is enough for public repositories.
GITHUB_TOKEN=
GITHUB_TIMEOUT_SECONDS=20
GITHUB_DOWNLOAD_TIMEOUT_SECONDS=120

# --- Repository import limits ---
MAX_REPO_SIZE_MB=200
MAX_ARCHIVE_MB=50
MAX_UNCOMPRESSED_MB=300
MAX_ARCHIVE_ENTRIES=50000
MAX_FILE_KB=256
MAX_FILES=3000

# --- Database (PostgreSQL + pgvector, see docker-compose.yml) ---
DATABASE_URL=postgresql+asyncpg://uaw:uaw@127.0.0.1:5432/uaw
DATABASE_POOL_SIZE=5

# --- Embeddings (Voyage AI) ---
# Required to import repositories. Create a key at https://dashboard.voyageai.com
VOYAGE_API_KEY=
EMBEDDING_MODEL=voyage-code-3
VOYAGE_TIMEOUT_SECONDS=60
VOYAGE_MAX_RETRIES=4
EMBEDDING_BATCH_SIZE=128
EMBEDDING_BATCH_MAX_CHARS=200000

# --- Imports ---
MAX_CONCURRENT_IMPORTS=2

# --- Answer generation (Claude) ---
# Required to answer questions. Create a key at https://platform.claude.com
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
LLM_EFFORT=medium
# Caps the cost of one answer (thinking included). Longest measured answer: ~900.
LLM_MAX_TOKENS=2000
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2
# Retry safety refusals on a fallback model chosen by the API (fallbacks: "default").
LLM_REFUSAL_FALLBACK=true
ANSWER_TOP_K=8
