# Production settings. Copy to deploy/.env, fill in every value, and keep the file
# readable by its owner only (chmod 600 .env). Never commit it.
# Generate secrets with: openssl rand -hex 32

# --- Public address ---
# The domain whose DNS A (and AAAA) records point to this server.
DOMAIN=demo.example.com

# --- Database ---
POSTGRES_PASSWORD=

# --- API keys of this server ---
# Admin key: imports and suggestions, from the server itself only.
API_KEY=
# Demo key: held by the web interface; questions on DEMO_REPOSITORIES only.
DEMO_API_KEY=
DEMO_REPOSITORIES=pallets/itsdangerous

# --- Model providers ---
VOYAGE_API_KEY=
ANTHROPIC_API_KEY=

# --- Cost control (required in production) ---
# Tokens per UTC day. 1000000 Claude tokens is about 140 questions (~5 USD), up to
# ~10-12 USD if every answer were long. Embeddings are cheap; imports use most of them.
DAILY_LLM_TOKEN_BUDGET=1000000
DAILY_EMBEDDING_TOKEN_BUDGET=5000000

# --- Optional ---
# Raises the GitHub API rate limit from 60 to 5,000 requests/hour.
GITHUB_TOKEN=
# Images to run (default: the latest images published by CI).
# BACKEND_IMAGE=ghcr.io/aurelienb20/uaw-backend:<commit sha>
# FRONTEND_IMAGE=ghcr.io/aurelienb20/uaw-frontend:<commit sha>
